{
  "name": "odin-members-only",
  "version": "1.0.0",
  "description": "A members-only message board built with Express, EJS, and PostgreSQL, featuring session authentication, membership access, and admin moderation.",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jan-christopher-buen/odin-members-only.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jan-christopher-buen/odin-members-only/issues"
  },
  "homepage": "https://github.com/jan-christopher-buen/odin-members-only#readme",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supertest": "7.3.1"
  }
}
